# Copy to .env.local for local development. In Vercel, add each of these
# under Project Settings -> Environment Variables. Every var below is
# optional at build time (the app falls back gracefully when unset) but
# required for the feature it powers to actually work in production.

# Supabase-backed phone number lookup (src/lib/settings.ts). Without these,
# the site falls back to NEXT_PUBLIC_FALLBACK_PHONE everywhere.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Displayed/dialed phone number when Supabase is not configured or its
# fetch fails (WhatsApp button, contact page, phone-number API route).
NEXT_PUBLIC_FALLBACK_PHONE=

# TMDB API key (movie/series metadata for the popular-content section).
NEXT_PUBLIC_TMDB_API_KEY=

# TheSportsDB API key. Defaults to the public demo key "123" if unset.
NEXT_PUBLIC_SPORTSDB_API_KEY=

# Google Analytics 4 measurement ID and/or Google Tag Manager container ID.
# Use one or the other, not both (GTM typically loads GA4 itself).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Bearer secret for POST /api/revalidate?tag=phone-number — required only
# to enable on-demand cache invalidation after updating the Supabase phone
# number; generate a long random string and keep it server-side only.
REVALIDATE_SECRET=
